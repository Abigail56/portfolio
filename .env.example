# Contact form (server-side only; never prefix these with NEXT_PUBLIC_).
# Create a key at https://resend.com/api-keys. Without it the form reports that sending is unavailable
# and points visitors to the email link instead; it never pretends a message was sent.
RESEND_API_KEY=
# Where messages are delivered.
CONTACT_TO_EMAIL=chinecheremchukwu15@gmail.com
# Sender. Resend's shared test sender works only for the account owner's own address;
# verify a domain in Resend to send from your own address.
CONTACT_FROM_EMAIL=Chukwu Chinecherem Portfolio <onboarding@resend.dev>

# Public URL of the deployed site, used for canonical links and social previews.
# Optional: only needed for a custom domain. On Vercel or Render the free address they assign is used automatically.
NEXT_PUBLIC_SITE_URL=
